# Copy this file to deploy/backend.env before running docker compose.

PYTHONUTF8=1

# Backend service
BACKEND_ENV=production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:1420,http://127.0.0.1:1420

# Default deployment only starts frontend/backend.
# If MySQL / Redis / TDengine run on Windows host with Docker Desktop, use host.docker.internal.
# If MySQL / Redis / TDengine are started with docker compose --profile infra,
# use MYSQL_HOST=mysql, REDIS_HOST=redis, TDENGINE_HOST=tdengine instead.
# Pass --env-file deploy/backend.env so Compose can read MYSQL_ROOT_PASSWORD.
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=<your-mysql-password>
MYSQL_DATABASE=device_watch
# Required only when Compose owns MySQL. Set a strong password before starting
# mysql:8.4; if MYSQL_USER=root above, this must equal MYSQL_PASSWORD.
# MySQL reads this initialization password only when mysql_data is first created.
MYSQL_ROOT_PASSWORD=

TDENGINE_HOST=host.docker.internal
TDENGINE_PORT=6041
TDENGINE_USER=root
TDENGINE_PASSWORD=<your-tdengine-password>
TDENGINE_DATABASE=device_data
# 「数据库日志」查看页读取 TDengine 服务日志的目录（compose 已把 tdengine 的
# /var/log/taos 以只读卷挂到 backend 的 /tdengine-logs）。仅 compose 托管 TDengine 时可用；
# 留空或目录不存在时该页面优雅提示不可用。
TDENGINE_LOG_DIR=/tdengine-logs

# Redis (realtime buffer layer, required)
# With `docker compose --profile infra`, set REDIS_HOST=redis so backend uses
# the private Compose network. The Redis service also requires this password.
# Use a strong random value; do not leave it blank in a running deployment.
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Auth — generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=<generate-a-strong-random-secret>
AUTH_AUTO_BOOTSTRAP=true
# Required for a production/non-development first install when Super is absent.
# Leave blank only until you set a unique value meeting the documented policy.
AUTH_BOOTSTRAP_SUPER_PASSWORD=

# Optional Perspective websocket/runtime settings, keep defaults unless your backend config requires them.
PERSPECTIVE_ENABLED=true

# Backend 调用 Windows Agent 的驱动编排服务凭据；必须与 Agent 进程环境一致。
DATAWATCH_AGENT_BASE_URL=http://host.docker.internal:7070
DATAWATCH_AGENT_SERVICE_TOKEN=<generate-a-strong-random-secret>

# DataWatch CLI compatibility and signed release storage.
CLI_API_VERSION=1.0
CLI_MIN_VERSION=0.2.0
CLI_MAX_VERSION=0.x
# Docker default is /app/cli-releases; local default is backend/cli-releases.
CLI_RELEASE_DIR=/app/cli-releases
