# collector settings 模板 —— 复制为 settings.toml 后按本地环境填写（settings.toml 已 gitignore）。
#
# 连接凭据（mysql/redis 的 host/port/user/database/password）在生产由 Agent 经
# DATAWATCH_<DB>_<FIELD> 环境变量统一下发并覆盖本文件——单一来源 = Agent 的 DPAPI
# 加密 config.toml。下面的连接值仅作「脱离 Agent 独立运行 collector」时的 dev 回退；
# 密码请留空或填本地开发库密码，切勿提交真实密码。

[runtime]
log_level = "INFO"
log_file = "logs/collector.log"
log_max_bytes = 10485760  # 10MB
log_backup_count = 5
enable_fake_bootstrap = false

# GE SRTP 实机验证建议按 250 → 500 → 1000 → 1024 递进；默认保持 250。
ge_max_payload_bytes = 250
# 双连接仅用于试点设备；默认单连接，当前只允许 1 或 2。
ge_parallel_channels = 1
# 可选：整批超过该时长后不再发起后续 Block；正在执行的 Block 会安全收尾。
# ge_batch_deadline_ms = 300

[mysql]
# host/port/user/database/password 生产由 Agent 注入覆盖；以下为 dev 回退值。
host = "127.0.0.1"
port = 3306
user = "root"
password = ""
database = "device_watch"
charset = "utf8mb4"
pool_size = 10
max_overflow = 20
pool_timeout = 30
pool_recycle = 3600

[interface_ingest]
enabled = true
host = "127.0.0.1"
port = 8090
path = "/ingest"
api_key = ""
max_batch_size = 1000

[redis]
# host/port/password 生产由 Agent 注入覆盖；以下为 dev 回退值。
host = "127.0.0.1"
port = 6379
db = 0
password = ""
stream_shard_count = 4
stream_maxlen = 50000  # 每 shard 上限。MAXLEN 卡条数不卡字节；单条约 9KB 时 ≈ 450MB/shard。组合数增多时按 Redis maxmemory 预算重算
