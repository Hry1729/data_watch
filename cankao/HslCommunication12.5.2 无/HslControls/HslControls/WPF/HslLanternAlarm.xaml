<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="HslControls.WPF.HslLanternAlarm" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:HslControls.WPF">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <local:ColorLightConverter x:Key="colorLightConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Viewbox>
    <Canvas Width="60" Height="85">
      <Rectangle Width="60" Height="8" Margin="0,77">
        <Shape.Fill>
          <SolidColorBrush Color="{Binding Path=BottomColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslLanternAlarm}}}" />
        </Shape.Fill>
      </Rectangle>
      <Rectangle Width="50" Height="8" Margin="5,70">
        <Shape.Fill>
          <SolidColorBrush Color="{Binding Path=BottomColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslLanternAlarm}}}" />
        </Shape.Fill>
      </Rectangle>
      <Ellipse Width="44" Height="44" Margin="8,0">
        <Shape.Fill>
          <SolidColorBrush Color="{Binding Path=LightColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslLanternAlarm}}}" />
        </Shape.Fill>
      </Ellipse>
      <Rectangle Width="44" Height="48" Margin="8,22">
        <Shape.Fill>
          <SolidColorBrush Color="{Binding Path=LightColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslLanternAlarm}}}" />
        </Shape.Fill>
      </Rectangle>
      <Line X1="5" Y1="77" X2="55" Y2="77">
        <Shape.Stroke>
          <SolidColorBrush Color="{Binding Path=BottomColor, Converter={StaticResource colorLightConverter}, ConverterParameter=30, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslLanternAlarm}}}" />
        </Shape.Stroke>
      </Line>
    </Canvas>
  </Viewbox>
</UserControl>