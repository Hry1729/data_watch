<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="HslControls.WPF.HslLanternSimple" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:HslControls.WPF">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <RadialGradientBrush x:Key="brush1" RadiusX="1" RadiusY="1" GradientOrigin="0.5 0.5">
        <GradientStop Offset="0" Color="{Binding Path=CenterBackground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslLanternSimple}}}" />
        <GradientStop Offset="1" Color="{Binding Path=LanternBackground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslLanternSimple}}}" />
      </RadialGradientBrush>
      <SolidColorBrush x:Key="brush2" Color="{Binding Path=LanternBackground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslLanternSimple}}}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Viewbox>
    <Canvas Width="100" Height="100">
      <Ellipse Width="100" Height="100" StrokeThickness="3">
        <Shape.Stroke>
          <SolidColorBrush Color="{Binding Path=LanternBackground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslLanternSimple}}}" />
        </Shape.Stroke>
      </Ellipse>
      <Ellipse Name="ellipse1" Width="86" Height="86" Margin="7">
        <Shape.Fill>
          <SolidColorBrush Color="{Binding Path=LanternBackground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslLanternSimple}}}" />
        </Shape.Fill>
      </Ellipse>
    </Canvas>
  </Viewbox>
</UserControl>