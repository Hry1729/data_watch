<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="HslControls.WPF.HslPumpOne" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:HslControls.WPF">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <TransformGroup x:Key="trans">
        <TranslateTransform Y="-50" />
      </TransformGroup>
      <local:AdditionValueConverter x:Key="converter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Viewbox>
      <Canvas Height="100" Width="100">
        <Rectangle Name="rect1" Canvas.Left="0" Canvas.Top="55" Width="50" Height="25">
          <Shape.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Offset="0" Color="{Binding Path=Color6, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslPumpOne}}}" />
              <GradientStop Color="WhiteSmoke" Offset="0.4" />
              <GradientStop Offset="1" Color="{Binding Path=Color6, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslPumpOne}}}" />
            </LinearGradientBrush>
          </Shape.Fill>
        </Rectangle>
        <Rectangle Name="rect2" Canvas.Left="0" Canvas.Top="52" Width="3" Height="31" Fill="#FF696969" />
        <Rectangle Name="rect3" Canvas.Left="0" Canvas.Top="55" Width="50" Height="25">
          <Shape.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Offset="0" Color="{Binding Path=Color6, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslPumpOne}}}" />
              <GradientStop Color="WhiteSmoke" Offset="0.4" />
              <GradientStop Offset="1" Color="{Binding Path=Color6, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslPumpOne}}}" />
            </LinearGradientBrush>
          </Shape.Fill>
          <UIElement.RenderTransform>
            <TransformGroup>
              <RotateTransform Angle="90" />
              <TranslateTransform X="80" Y="-55" />
            </TransformGroup>
          </UIElement.RenderTransform>
        </Rectangle>
        <Rectangle Name="rect4" Canvas.Left="0" Canvas.Top="52" Width="3" Height="31" Fill="#FF696969">
          <UIElement.RenderTransform>
            <TransformGroup>
              <RotateTransform Angle="90" />
              <TranslateTransform X="83" Y="-52" />
            </TransformGroup>
          </UIElement.RenderTransform>
        </Rectangle>
        <Polygon Points="50,60 25,100 75,100 50,60">
          <Shape.Fill>
            <SolidColorBrush Color="{Binding Path=Color1, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslPumpOne}}}" />
          </Shape.Fill>
        </Polygon>
        <Polygon Points="22,96 78,96 78,100 22,100">
          <Shape.Fill>
            <SolidColorBrush Color="{Binding Path=Color2, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslPumpOne}}}" />
          </Shape.Fill>
        </Polygon>
        <Ellipse Canvas.Left="20" Canvas.Top="20" Width="60" Height="60">
          <Shape.Fill>
            <SolidColorBrush Color="{Binding Path=Color3, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslPumpOne}}}" />
          </Shape.Fill>
        </Ellipse>
        <Ellipse Canvas.Left="26" Canvas.Top="26" Width="48" Height="48">
          <Shape.Fill>
            <SolidColorBrush Color="{Binding Path=Color4, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslPumpOne}}}" />
          </Shape.Fill>
        </Ellipse>
        <Line X1="30" Y1="50" X2="70" Y2="50" StrokeThickness="3" Stroke="#FF5C646F" RenderTransformOrigin="0.715,0.96">
          <UIElement.RenderTransform>
            <TransformGroup>
              <ScaleTransform />
              <SkewTransform />
              <RotateTransform Angle="{Binding Path=StartAngle, Converter={StaticResource converter}, ConverterParameter=0, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslPumpOne}}}" />
              <TranslateTransform />
            </TransformGroup>
          </UIElement.RenderTransform>
        </Line>
        <Line X1="30" Y1="50" X2="70" Y2="50" StrokeThickness="3" Stroke="#FF5C646F" RenderTransformOrigin="0.715,0.96">
          <UIElement.RenderTransform>
            <TransformGroup>
              <ScaleTransform />
              <SkewTransform />
              <RotateTransform Angle="{Binding Path=StartAngle, Converter={StaticResource converter}, ConverterParameter=45, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslPumpOne}}}" />
              <TranslateTransform />
            </TransformGroup>
          </UIElement.RenderTransform>
        </Line>
        <Line X1="30" Y1="50" X2="70" Y2="50" StrokeThickness="3" Stroke="#FF5C646F" RenderTransformOrigin="0.715,0.96">
          <UIElement.RenderTransform>
            <TransformGroup>
              <ScaleTransform />
              <SkewTransform />
              <RotateTransform Angle="{Binding Path=StartAngle, Converter={StaticResource converter}, ConverterParameter=90, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslPumpOne}}}" />
              <TranslateTransform />
            </TransformGroup>
          </UIElement.RenderTransform>
        </Line>
        <Line X1="30" Y1="50" X2="70" Y2="50" StrokeThickness="3" Stroke="#FF5C646F" RenderTransformOrigin="0.715,0.96">
          <UIElement.RenderTransform>
            <TransformGroup>
              <ScaleTransform />
              <SkewTransform />
              <RotateTransform Angle="{Binding Path=StartAngle, Converter={StaticResource converter}, ConverterParameter=135, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslPumpOne}}}" />
              <TranslateTransform />
            </TransformGroup>
          </UIElement.RenderTransform>
        </Line>
        <Ellipse Canvas.Left="41" Canvas.Top="41" Width="18" Height="18">
          <Shape.Fill>
            <SolidColorBrush Color="{Binding Path=Color5, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslPumpOne}}}" />
          </Shape.Fill>
        </Ellipse>
        <Ellipse Canvas.Left="42" Canvas.Top="42" Width="16" Height="16">
          <Shape.Fill>
            <SolidColorBrush Color="{Binding Path=Color6, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslPumpOne}}}" />
          </Shape.Fill>
        </Ellipse>
        <Ellipse Canvas.Left="48" Canvas.Top="48" Width="4" Height="4">
          <Shape.Fill>
            <SolidColorBrush Color="{Binding Path=Color5, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslPumpOne}}}" />
          </Shape.Fill>
        </Ellipse>
        <Ellipse Canvas.Left="49" Canvas.Top="49" Width="2" Height="2">
          <Shape.Fill>
            <SolidColorBrush Color="{Binding Path=Color7, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslPumpOne}}}" />
          </Shape.Fill>
        </Ellipse>
      </Canvas>
    </Viewbox>
  </Grid>
</UserControl>