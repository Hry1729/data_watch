<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="HslControls.WPF.HslMoveText" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:HslControls.WPF" x:Name="userControl1">
  <Canvas Name="canvas1" ClipToBounds="True">
    <Label Name="label1" VerticalContentAlignment="Center" Height="{Binding ElementName=canvas1, Path=ActualHeight}" Canvas.Left="{Binding ElementName=canvas1, Path=ActualWidth}" Foreground="{Binding ElementName=userControl1, Path=Foreground}" Content="{Binding Path=Text, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslMoveText}}}" />
  </Canvas>
</UserControl>