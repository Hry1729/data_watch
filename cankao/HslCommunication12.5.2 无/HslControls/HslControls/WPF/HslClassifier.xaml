<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="HslControls.WPF.HslClassifier" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:HslControls.WPF" Foreground="#FFF5F5F5">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <local:VisibilityStringConverter x:Key="converter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Viewbox Stretch="Fill">
    <Canvas Width="100" Height="100">
      <Rectangle Canvas.Top="0" Canvas.Left="2" Width="96" Height="2" Stroke="#FF696969" StrokeThickness="0.5">
        <Shape.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientBrush.GradientStops>
              <GradientStop Offset="0" Color="{Binding Path=EdgeColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslClassifier}}}" />
              <GradientStop Color="WhiteSmoke" Offset="0.45" />
              <GradientStop Offset="1" Color="{Binding Path=EdgeColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslClassifier}}}" />
            </GradientBrush.GradientStops>
          </LinearGradientBrush>
        </Shape.Fill>
      </Rectangle>
      <Rectangle Canvas.Top="2" Canvas.Left="0" Width="100" Height="52" Stroke="#FF696969" StrokeThickness="0.5">
        <Shape.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientBrush.GradientStops>
              <GradientStop Offset="0" Color="{Binding Path=EdgeColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslClassifier}}}" />
              <GradientStop Color="WhiteSmoke" Offset="0.45" />
              <GradientStop Offset="1" Color="{Binding Path=EdgeColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslClassifier}}}" />
            </GradientBrush.GradientStops>
          </LinearGradientBrush>
        </Shape.Fill>
      </Rectangle>
      <Polygon Points="0,54 99,54 65,80 35,80" Stroke="#FF696969" StrokeThickness="0.5">
        <Shape.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientBrush.GradientStops>
              <GradientStop Offset="0" Color="{Binding Path=EdgeColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslClassifier}}}" />
              <GradientStop Color="WhiteSmoke" Offset="0.45" />
              <GradientStop Offset="1" Color="{Binding Path=EdgeColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslClassifier}}}" />
            </GradientBrush.GradientStops>
          </LinearGradientBrush>
        </Shape.Fill>
      </Polygon>
      <Rectangle Canvas.Top="80" Canvas.Left="35" Width="30" Height="17" Stroke="#FF696969" StrokeThickness="0.5">
        <Shape.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientBrush.GradientStops>
              <GradientStop Offset="0" Color="{Binding Path=EdgeColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslClassifier}}}" />
              <GradientStop Color="WhiteSmoke" Offset="0.45" />
              <GradientStop Offset="1" Color="{Binding Path=EdgeColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslClassifier}}}" />
            </GradientBrush.GradientStops>
          </LinearGradientBrush>
        </Shape.Fill>
      </Rectangle>
      <Ellipse Canvas.Top="94" Canvas.Left="35" Width="30" Height="7" Stroke="#FF696969" StrokeThickness="0.5">
        <Shape.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientBrush.GradientStops>
              <GradientStop Offset="0" Color="{Binding Path=EdgeColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslClassifier}}}" />
              <GradientStop Color="WhiteSmoke" Offset="0.45" />
              <GradientStop Offset="1" Color="{Binding Path=EdgeColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslClassifier}}}" />
            </GradientBrush.GradientStops>
          </LinearGradientBrush>
        </Shape.Fill>
      </Ellipse>
      <Rectangle Canvas.Top="80" Canvas.Left="35" Width="30" Height="17">
        <Shape.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientBrush.GradientStops>
              <GradientStop Offset="0" Color="{Binding Path=EdgeColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslClassifier}}}" />
              <GradientStop Color="WhiteSmoke" Offset="0.45" />
              <GradientStop Offset="1" Color="{Binding Path=EdgeColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslClassifier}}}" />
            </GradientBrush.GradientStops>
          </LinearGradientBrush>
        </Shape.Fill>
      </Rectangle>
      <Label Name="label1" Canvas.Top="18" Canvas.Left="20" Width="60" Height="20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#303030" FontSize="7" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslClassifier}}}" Content="{Binding Path=Text, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslClassifier}}}" Visibility="{Binding ElementName=label1, Path=Content, Converter={StaticResource converter}}" />
    </Canvas>
  </Viewbox>
</UserControl>