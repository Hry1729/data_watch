<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="HslControls.WPF.HslBottle" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:HslControls.WPF">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <local:ProgressConverter x:Key="progressConverter" />
      <LinearGradientBrush x:Key="backBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0.0" Color="{Binding Path=BackColorEdge, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslBottle}}}" />
        <GradientStop Offset="0.5" Color="{Binding Path=BackColorCenter, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslBottle}}}" />
        <GradientStop Offset="1.0" Color="{Binding Path=BackColorEdge, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslBottle}}}" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="foreBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0.0" Color="{Binding Path=ForeColorEdge, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslBottle}}}" />
        <GradientStop Offset="0.5" Color="{Binding Path=ForeColorCenter, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslBottle}}}" />
        <GradientStop Offset="1.0" Color="{Binding Path=ForeColorEdge, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslBottle}}}" />
      </LinearGradientBrush>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock TextAlignment="Center" Text="{Binding Path=HeadTag, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslBottle}}}" />
      <Viewbox Stretch="Fill" Grid.Row="1">
        <Canvas Width="40" Height="112">
          <Polygon StrokeThickness="1" Points="0,2 0,102 20,112 40,102 40,2" Fill="{StaticResource backBrush}" Stroke="{Binding Path=BackColorEdge, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:HslBottle}}" />
          <Ellipse StrokeThickness="1" Width="40" Height="4" Stroke="{Binding Path=BackColorTop, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslBottle}}}">
            <Shape.Fill>
              <SolidColorBrush Color="{Binding Path=BackColorTop, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslBottle}}}" />
            </Shape.Fill>
          </Ellipse>
          <Polygon StrokeThickness="1" Points="0,102 20,112 40,102" Stroke="{Binding Path=ForeColorEdge, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:HslBottle}}">
            <Shape.Fill>
              <SolidColorBrush Color="{Binding Path=ForeColorEdge, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslBottle}}}" />
            </Shape.Fill>
          </Polygon>
          <Rectangle Width="40" Fill="{StaticResource foreBrush}" Canvas.Top="{Binding Path=Value, Converter={StaticResource progressConverter}, ConverterParameter=2, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslBottle}}}" Height="{Binding Path=Value, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslBottle}}}" />
          <Ellipse Canvas.Top="100" Width="40" Height="4" Fill="{StaticResource foreBrush}" />
          <Ellipse StrokeThickness="1" Width="40" Height="4" Stroke="{Binding Path=ForeColorTop, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslBottle}}}" Canvas.Top="{Binding Path=Value, Converter={StaticResource progressConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslBottle}}}">
            <Shape.Fill>
              <SolidColorBrush Color="{Binding Path=ForeColorTop, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslBottle}}}" />
            </Shape.Fill>
          </Ellipse>
          <Rectangle Canvas.Top="107" Canvas.Left="10" Width="20" Height="5">
            <Shape.Fill>
              <SolidColorBrush Color="#696969" />
            </Shape.Fill>
          </Rectangle>
          <Ellipse Canvas.Top="105" Canvas.Left="10" Width="20" Height="4">
            <Shape.Fill>
              <SolidColorBrush Color="{Binding Path=ForeColorEdge, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslBottle}}}" />
            </Shape.Fill>
          </Ellipse>
        </Canvas>
      </Viewbox>
    </Grid>
    <TextBlock Margin="0,40,0,0" VerticalAlignment="Top" TextAlignment="Center" Foreground="#FF808080" Text="{Binding Path=BottleTag, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslBottle}}}" />
  </Grid>
</UserControl>