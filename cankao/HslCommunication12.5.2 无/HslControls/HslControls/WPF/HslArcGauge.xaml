<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="HslControls.WPF.HslArcGauge" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:HslControls.WPF">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <LinearGradientBrush x:Key="BR1" EndPoint="0.5,1" StartPoint="0.5,0">
        <Brush.RelativeTransform>
          <TransformGroup>
            <ScaleTransform CenterY="0.5" CenterX="0.5" />
            <SkewTransform CenterY="0.5" CenterX="0.5" />
            <RotateTransform Angle="-35" CenterY="0.5" CenterX="0.5" />
            <TranslateTransform />
          </TransformGroup>
        </Brush.RelativeTransform>
        <GradientStop Color="#FFC1C1C1" Offset="0" />
        <GradientStop Color="#FFC1C1C1" Offset="1" />
        <GradientStop Color="#FF262626" Offset="0.5" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="BR2" Color="#FF242424" />
      <SolidColorBrush x:Key="BR3" Color="#494949" />
      <RadialGradientBrush x:Key="BR4">
        <GradientStop Color="#FF4B4B4B" Offset="0" />
        <GradientStop Color="#FF242424" Offset="1" />
      </RadialGradientBrush>
      <SolidColorBrush x:Key="BR5" Color="Yellow" />
      <SolidColorBrush x:Key="BR6" Color="White" />
      <local:Double2StringConverter x:Key="Double2Str" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Viewbox Stretch="Uniform">
    <Grid Height="350" Width="350" DataContext="{Binding RelativeSource={RelativeSource AncestorLevel=1, AncestorType=UserControl, Mode=FindAncestor}}">
      <Ellipse Fill="{StaticResource BR1}" />
      <Grid Width="320" Height="320">
        <Ellipse Width="320" Height="320" Fill="{StaticResource BR2}" />
        <Path StrokeThickness="1" Data="M160,160 L160,320 A160,160 0 1 1 320,160L160,160" Fill="{StaticResource BR3}" />
        <Path StrokeThickness="1" Fill="{Binding GaugeColor}">
          <Path.Data>
            <PathGeometry>
              <PathGeometry.Figures>
                <PathFigureCollection>
                  <PathFigure StartPoint="160,160">
                    <PathFigure.Segments>
                      <PathSegmentCollection>
                        <LineSegment Point="160,320" />
                        <ArcSegment Size="160,160" x:Name="arcGauge" IsLargeArc="False" SweepDirection="Clockwise" Point="160,320" />
                        <LineSegment Point="160,160" />
                      </PathSegmentCollection>
                    </PathFigure.Segments>
                  </PathFigure>
                </PathFigureCollection>
              </PathGeometry.Figures>
            </PathGeometry>
          </Path.Data>
        </Path>
        <Rectangle Width="1" Height="320" Fill="{StaticResource BR2}" Stroke="{x:Null}" />
        <Rectangle Width="1" Height="320" Fill="{StaticResource BR2}" RenderTransformOrigin="0.5,0.5" Stroke="{x:Null}">
          <UIElement.RenderTransform>
            <TransformGroup>
              <ScaleTransform />
              <SkewTransform />
              <RotateTransform Angle="15" />
              <TranslateTransform />
            </TransformGroup>
          </UIElement.RenderTransform>
        </Rectangle>
        <Rectangle Width="1" Height="320" Fill="{StaticResource BR2}" RenderTransformOrigin="0.5,0.5" Margin="159.5,0" Stroke="{x:Null}">
          <UIElement.RenderTransform>
            <TransformGroup>
              <ScaleTransform />
              <SkewTransform />
              <RotateTransform Angle="30" />
              <TranslateTransform />
            </TransformGroup>
          </UIElement.RenderTransform>
        </Rectangle>
        <Rectangle Width="1" Height="320" Fill="{StaticResource BR2}" RenderTransformOrigin="0.5,0.5" Margin="159.5,0" Stroke="{x:Null}">
          <UIElement.RenderTransform>
            <TransformGroup>
              <ScaleTransform />
              <SkewTransform />
              <RotateTransform Angle="45" />
              <TranslateTransform />
            </TransformGroup>
          </UIElement.RenderTransform>
        </Rectangle>
        <Rectangle Width="1" Height="320" Fill="{StaticResource BR2}" RenderTransformOrigin="0.5,0.5" Margin="159.5,0" Stroke="{x:Null}">
          <UIElement.RenderTransform>
            <TransformGroup>
              <ScaleTransform />
              <SkewTransform />
              <RotateTransform Angle="60" />
              <TranslateTransform />
            </TransformGroup>
          </UIElement.RenderTransform>
        </Rectangle>
        <Rectangle Width="1" Height="320" Fill="{StaticResource BR2}" RenderTransformOrigin="0.5,0.5" Margin="159.5,0" Stroke="{x:Null}">
          <UIElement.RenderTransform>
            <TransformGroup>
              <ScaleTransform />
              <SkewTransform />
              <RotateTransform Angle="75" />
              <TranslateTransform />
            </TransformGroup>
          </UIElement.RenderTransform>
        </Rectangle>
        <Rectangle Width="1" Height="320" Fill="{StaticResource BR2}" RenderTransformOrigin="0.5,0.5" Margin="159.5,0" Stroke="{x:Null}">
          <UIElement.RenderTransform>
            <TransformGroup>
              <ScaleTransform />
              <SkewTransform />
              <RotateTransform Angle="90" />
              <TranslateTransform />
            </TransformGroup>
          </UIElement.RenderTransform>
        </Rectangle>
        <Rectangle Width="1" Height="320" Fill="{StaticResource BR2}" RenderTransformOrigin="0.5,0.5" Margin="159.5,0" Stroke="{x:Null}">
          <UIElement.RenderTransform>
            <TransformGroup>
              <ScaleTransform />
              <SkewTransform />
              <RotateTransform Angle="105" />
              <TranslateTransform />
            </TransformGroup>
          </UIElement.RenderTransform>
        </Rectangle>
        <Rectangle Width="1" Height="320" Fill="{StaticResource BR2}" RenderTransformOrigin="0.5,0.5" Margin="159.5,0" Stroke="{x:Null}">
          <UIElement.RenderTransform>
            <TransformGroup>
              <ScaleTransform />
              <SkewTransform />
              <RotateTransform Angle="120" />
              <TranslateTransform />
            </TransformGroup>
          </UIElement.RenderTransform>
        </Rectangle>
        <Rectangle Width="1" Height="320" Fill="{StaticResource BR2}" RenderTransformOrigin="0.5,0.5" Margin="159.5,0" Stroke="{x:Null}">
          <UIElement.RenderTransform>
            <TransformGroup>
              <ScaleTransform />
              <SkewTransform />
              <RotateTransform Angle="135" />
              <TranslateTransform />
            </TransformGroup>
          </UIElement.RenderTransform>
        </Rectangle>
        <Rectangle Width="1" Height="320" Fill="{StaticResource BR2}" RenderTransformOrigin="0.5,0.5" Margin="159.5,0" Stroke="{x:Null}">
          <UIElement.RenderTransform>
            <TransformGroup>
              <ScaleTransform />
              <SkewTransform />
              <RotateTransform Angle="150" />
              <TranslateTransform />
            </TransformGroup>
          </UIElement.RenderTransform>
        </Rectangle>
        <Rectangle Width="1" Height="320" Fill="{StaticResource BR2}" RenderTransformOrigin="0.5,0.5" Margin="159.5,0" Stroke="{x:Null}">
          <UIElement.RenderTransform>
            <TransformGroup>
              <ScaleTransform />
              <SkewTransform />
              <RotateTransform Angle="165" />
              <TranslateTransform />
            </TransformGroup>
          </UIElement.RenderTransform>
        </Rectangle>
        <Ellipse Width="250" Height="250" VerticalAlignment="Bottom" Margin="0,0,0,5" Fill="{StaticResource BR4}" />
        <TextBlock FontSize="24" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,110,0,0" Foreground="{StaticResource BR5}" Text="{Binding GaugeTitle}" />
        <TextBlock FontSize="24" FontWeight="Bold" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,30" Foreground="{StaticResource BR6}" Text="{Binding GaugeUnit}" />
        <TextBlock Name="textBlockValue" Foreground="{StaticResource BR6}" FontSize="80" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,50,0,0" Text="{Binding Path=Value, Converter={StaticResource Double2Str}}" />
        <TextBlock Name="textBlockSettingValue" FontSize="24" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,60" Text="{Binding SettingValue, Converter={StaticResource Double2Str}}" Foreground="{Binding SettingGaugeColor}" />
      </Grid>
      <Path Name="ptSetup" Stretch="Fill" StrokeThickness="6" Margin="169,0,169,2" VerticalAlignment="Bottom" Height="10" Data="M175,341 L172,345 L178,345" RenderTransformOrigin="0.5,-16.3" Stroke="{Binding SettingGaugeColor}" />
    </Grid>
  </Viewbox>
</UserControl>