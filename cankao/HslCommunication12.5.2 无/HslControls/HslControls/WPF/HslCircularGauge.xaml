<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="HslControls.WPF.HslCircularGauge" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:HslControls.WPF">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <local:ImageOffsetConverter x:Key="imageOffsetConverter" />
      <local:RadiusToDiameterConverter x:Key="radiusToDiameterConverter" />
      <local:PointerCenterConverter x:Key="pointerCenterConverter" />
      <local:RangeIndicatorLightPositionConverter x:Key="rangeIndicatorLightPositionConverter" />
      <local:SizeConverter x:Key="sizeConverter" />
      <local:BackgroundColorConverter x:Key="backgroundColorConverter" />
      <local:GlassEffectWidthConverter x:Key="glassEffectWidthConverter" />
      <local:ColorToSolidColorBrushConverter x:Key="colorToSolidColorBrushConverter" />
      <Style x:Key="{x:Type local:HslCircularGauge}" TargetType="{x:Type local:HslCircularGauge}">
        <Setter Property="local:HslCircularGauge.ResetPointerOnStartUp" Value="True" />
        <Setter Property="local:HslCircularGauge.ScaleValuePrecision" Value="5" />
        <Setter Property="BorderBrush">
          <Setter.Value>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
              <GradientStop Color="#FFA3AFD6" Offset="0.321" />
              <GradientStop Color="#FF8399A9" Offset="0.674" />
              <GradientStop Color="#FF718597" Offset="0.375" />
              <GradientStop Color="#FF617584" Offset="1" />
            </LinearGradientBrush>
          </Setter.Value>
        </Setter>
        <Setter Property="local:HslCircularGauge.BelowOptimalRangeColor" Value="Yellow" />
        <Setter Property="local:HslCircularGauge.OptimalRangeColor" Value="Green" />
        <Setter Property="local:HslCircularGauge.AboveOptimalRangeColor" Value="Red" />
        <Setter Property="local:HslCircularGauge.DialTextColor" Value="White" />
        <Setter Property="local:HslCircularGauge.DialTextFontSize" Value="8" />
        <Setter Property="local:HslCircularGauge.ScaleLabelFontSize" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type local:HslCircularGauge}">
              <Viewbox Stretch="Uniform">
                <Grid Name="LayoutRoot" Height="{Binding Path=Radius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource radiusToDiameterConverter}}" Width="{Binding Path=Radius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource radiusToDiameterConverter}}">
                  <Ellipse Name="OuterFrame" StrokeThickness="{TemplateBinding local:HslCircularGauge.DialBorderThickness}" Height="{Binding Path=Radius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource radiusToDiameterConverter}}" Width="{Binding Path=Radius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource radiusToDiameterConverter}}" Fill="{Binding Path=GaugeBackgroundColor, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource backgroundColorConverter}}">
                    <Shape.Stroke>
                      <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FF636060" Offset="1" />
                        <GradientStop Color="#FF5F5C5C" Offset="0" />
                        <GradientStop Color="#FFEEDEDE" Offset="0.35" />
                        <GradientStop Color="#FFA09595" Offset="0.705" />
                      </LinearGradientBrush>
                    </Shape.Stroke>
                  </Ellipse>
                  <Image Source="{TemplateBinding local:HslCircularGauge.ImageSource}" Width="{Binding Path=ImageSize, ConverterParameter=Width, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource sizeConverter}}" Height="{Binding Path=ImageSize, ConverterParameter=Height, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource sizeConverter}}" RenderTransform="{Binding Path=ImageOffset, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource imageOffsetConverter}}" />
                  <TextBlock Text="{TemplateBinding local:HslCircularGauge.DialText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{Binding Path=DialTextColor, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource colorToSolidColorBrushConverter}}" FontSize="{Binding Path=DialTextFontSize, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslCircularGauge}}}" RenderTransform="{Binding Path=DialTextOffset, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource rangeIndicatorLightPositionConverter}}" />
                  <Path Name="Pointer" Stroke="#FFE91C1C" StrokeThickness="2" Width="{TemplateBinding local:HslCircularGauge.PointerLength}" Height="{TemplateBinding local:HslCircularGauge.PointerThickness}" HorizontalAlignment="Center" Data="M1,1 L1,10 L156,6" Stretch="Fill" RenderTransformOrigin="0,0.5" RenderTransform="{Binding Path=PointerLength, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource pointerCenterConverter}}">
                    <Shape.Fill>
                      <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FF890A0A" Offset="0.197" />
                        <GradientStop Color="#FFC40808" Offset="1" />
                        <GradientStop Color="#FFE32323" Offset="0.61" />
                      </LinearGradientBrush>
                    </Shape.Fill>
                  </Path>
                  <Ellipse Name="PointerCap" Height="{TemplateBinding local:HslCircularGauge.PointerCapRadius}" Width="{TemplateBinding local:HslCircularGauge.PointerCapRadius}" StrokeThickness="4" Opacity="1">
                    <Shape.Stroke>
                      <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FF000000" Offset="0.675" />
                        <GradientStop Color="#FFC1B5B5" Offset="0.031" />
                      </LinearGradientBrush>
                    </Shape.Stroke>
                    <Shape.Fill>
                      <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FF152029" Offset="0.846" />
                        <GradientStop Color="#FF140204" Offset="0.342" />
                      </LinearGradientBrush>
                    </Shape.Fill>
                  </Ellipse>
                  <Ellipse Name="RangeIndicatorLight" Height="{Binding Path=RangeIndicatorLightRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource radiusToDiameterConverter}}" Width="{Binding Path=RangeIndicatorLightRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource radiusToDiameterConverter}}" RenderTransform="{Binding Path=RangeIndicatorLightOffset, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource rangeIndicatorLightPositionConverter}}">
                    <Shape.Fill>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="LightGray" Offset="0.2" />
                        <GradientStop Color="Gray" Offset="0.5" />
                        <GradientStop Color="Black" Offset="0.8" />
                      </LinearGradientBrush>
                    </Shape.Fill>
                  </Ellipse>
                  <Path Name="GlassEffect" StrokeThickness="1" Stretch="Fill" VerticalAlignment="Bottom" Height="{TemplateBinding local:HslCircularGauge.Radius}" Opacity="0.18" Data="M265.99997,151.00005 C263.99994,194.00003 209.55908,259 135.00064,259 C60.442207,259 11,200.00003 5.9999995,157.00005 C5.0181994,148.55656 73.000877,112.00006 137.00053,112.00007 C199.00887,112.00008 266.72015,135.5164 265.99997,151.00005" Width="{Binding Path=Radius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource glassEffectWidthConverter}}">
                    <Shape.Fill>
                      <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#68FCFCFC" />
                        <GradientStop Color="#FFF8FCF8" Offset="1" />
                      </LinearGradientBrush>
                    </Shape.Fill>
                  </Path>
                </Grid>
              </Viewbox>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
</UserControl>