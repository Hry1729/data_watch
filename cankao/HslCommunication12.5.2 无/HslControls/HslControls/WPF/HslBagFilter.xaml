  <FrameworkElement.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="lineColor" Color="{Binding Path=BorderColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslBagFilter}}}" />
      <LinearGradientBrush x:Key="rectLinear" StartPoint="0,0" EndPoint="1,0">
        <GradientBrush.GradientStops>
          <GradientStop Offset="0" Color="{Binding Path=EdgeColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslBagFilter}}}" />
          <GradientStop Offset="0.45" Color="{Binding Path=CenterColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslBagFilter}}}" />
          <GradientStop Offset="1" Color="{Binding Path=EdgeColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslBagFilter}}}" />
        </GradientBrush.GradientStops>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="headLinear" StartPoint="0,0" EndPoint="1,0">
        <GradientBrush.GradientStops>
          <GradientStop Offset="0" Color="{Binding Path=BorderColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslBagFilter}}}" />
          <GradientStop Offset="0.45" Color="{Binding Path=CenterColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslBagFilter}}}" />
          <GradientStop Offset="1" Color="{Binding Path=BorderColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HslBagFilter}}}" />
        </GradientBrush.GradientStops>
      </LinearGradientBrush>
    </ResourceDictionary>
