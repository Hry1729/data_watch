  "cards": [
    {
      "dot": "cyan",
      "title": "契约保持",
      "items": [
        "协议差异止于驱动层，Collector 之后只流转统一点位与质量码",
        "中心化与分布式入口汇合到同一 Redis Stream / Writer 契约",
        "Web、App 与 CLI 复用 Backend 业务契约，App 另经 Agent 完成本机控制"
      ]
    },
    {
      "dot": "emerald",
      "title": "可靠性不变量",
      "items": [
        "边缘先落盘、严格顺序、单批在途；中心以高水位和 Lua 保证幂等",
        "Writer 仅在 LANDED 或进入 DLQ 后 ACK，latest 始终最后更新"
      ]
    },
    {
      "dot": "rose",
      "title": "可治理 AI 调用",
      "items": [
        "AI 与人员复用 Backend 的账号、JWT、RBAC 和审计边界",
        "高风险写操作必须 dry-run 并显式确认；MCP 为后续扩展而非当前前提"
      ]
    }
  ]
