+    这里显式声明空代理表：只影响本 opener，不改动进程的代理环境变量。
+    """
+
+    def __init__(self) -> None:
+        super().__init__({})
+
+
+_TDENGINE_OPENER = urllib.request.build_opener(_NoRedirectHandler, _NoProxyHandler())
