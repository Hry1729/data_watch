# writer settings 模板 —— 复制为 settings.toml 后按本地环境填写（settings.toml 已 gitignore）。
#
# 连接凭据（redis/mysql/tdengine 的 host/port/user/database/password）在生产由 Agent 经
# DATAWATCH_<DB>_<FIELD> 环境变量统一下发并覆盖本文件——单一来源 = Agent 的 DPAPI
# 加密 config.toml。下面的连接值仅作「脱离 Agent 独立运行 writer」时的 dev 回退；
# 密码请留空或填本地开发库密码，切勿提交真实密码。

[redis]
# host/port/password 生产由 Agent 注入覆盖；以下为 dev 回退值。
host = "127.0.0.1"
port = 6379
db = 0
password = ""
stream_shard_count = 4
group_name = "writer_cg"
consumer_name = "writer-1"

[tdengine]
# host/port/user/database/password 生产由 Agent 注入覆盖；以下为 dev 回退值。
host = "127.0.0.1"
port = 6041
user = "root"
password = ""
database = "device_data"

[mysql]
# host/port/user/database/password 生产由 Agent 注入覆盖；以下为 dev 回退值。
host = "127.0.0.1"
port = 3306
user = "root"
password = ""
database = "device_watch"

[writer]
flush_interval_ms = 500
batch_count = 200
max_buffer_rows = 2000
max_buffer_bytes = 33554432
pending_min_idle_ms = 30000
pending_drain_interval_s = 5
pending_cycle_budget_ms = 100
performance_report_interval_s = 30  # per-worker and aggregate backlog/lag/PEL metrics
scope_refresh_interval_s = 60  # 运行期发现新增 device_type/group_code；<=0 按 1 秒限幅
# 每个 rt:dlq:{device_type}:{group_code} 的保留上限；0 表示不裁剪（默认，无损）。
# 配置正数会在超限时淘汰最旧死信，必须由部署方显式接受该数据损失策略。
dlq_max_size = 0
dlq_alert_threshold = 0.9
# 无界模式达到此条目数时记录 warning；<=0 禁用。
dlq_warn_entries = 1000
