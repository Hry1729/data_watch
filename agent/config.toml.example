# config.toml — DataWatch Agent 配置模板
# 复制为 config.toml 后按实际环境填写
# 密码字段以 DPAPI 加密后的 base64 字符串存储（password_enc）
# config.toml 与 Windows 用户账户 + 机器绑定，不可跨机直接复制

[agent]
host               = "127.0.0.1"
port               = 7070
jwt_secret         = ""            # 首次启动时自动随机生成，32 字节 hex
jwt_expire_hours   = 8
bootstrap_done     = false
log_level          = "INFO"

[redis]
host               = "127.0.0.1"
port               = 6379
password_enc       = ""            # DPAPI 加密后的 base64；空串=无密码

[mysql]
host               = "127.0.0.1"
port               = 3306
user               = "root"
database           = "device_watch"
password_enc       = ""            # DPAPI 加密后的 base64

[tdengine]
host               = "127.0.0.1"
port               = 6041
user               = "root"
database           = "device_data"
password_enc       = ""            # DPAPI 加密后的 base64

[collector]
executable         = "collector.exe"
working_dir        = ""            # 必须配置，否则 start 返回 400

[writer]
executable         = "writer.exe"
working_dir        = ""            # 必须配置，否则 start 返回 400
