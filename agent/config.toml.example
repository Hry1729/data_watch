# config.toml — DataWatch Agent 配置模板
# 复制为 config.toml 后按实际环境填写
# 密码字段以 DPAPI 加密后的 base64 字符串存储（password_enc）
# config.toml 与 Windows 用户账户 + 机器绑定，不可跨机直接复制

[agent]
host               = "127.0.0.1"
port               = 7070
jwt_secret         = ""            # 留空仅限首装（bootstrap_done=false）：首次加载会原子生成 32 字节 hex 并写回本文件。
                                   # bootstrap 完成后该值必须非空且 >=32 字符，否则 Agent 拒绝启动（空密钥可伪造管理员令牌）。
                                   # 手工修改该值会使所有已签发令牌失效，需重新登录。
jwt_expire_hours   = 8
bootstrap_done     = false
log_level          = "INFO"

[redis]
host               = "127.0.0.1"
port               = 6379
password_enc       = ""            # DPAPI 加密后的 base64；空串=无密码
db                 = 0             # 实时 stream 所在 DB：Agent 同时下发给 Ingest(写) 与 Writer(读)
stream_shard_count = 4             # 每个点组的 stream 分片数：同上，两侧必须一致

[mysql]
host               = "127.0.0.1"
port               = 3306
user               = "root"
database           = "device_watch"
password_enc       = ""            # DPAPI 加密后的 base64

[tdengine]
host               = "127.0.0.1"
port               = 6041
user               = "root"
database           = "device_data"
password_enc       = ""            # DPAPI 加密后的 base64

[backend]
base_url           = "http://127.0.0.1:8000"   # Console 后端地址，引导页录入（无密码，明文存储）

# collector / writer 进程路径由安装根(DATAWATCH_INSTALL_ROOT)与数据根(DATAWATCH_DATA_ROOT)
# 自动派生，不在 config.toml 中配置。
