# collector settings 模板 —— 安装器复制到 C:\ProgramData\DataWatch\collector\config\settings.toml
# 连接凭据（mysql/redis 的 host/port/user/database/password）由 Agent 经
# DATAWATCH_<DB>_<FIELD> 环境变量统一注入并覆盖本文件——单一来源 = Agent 的 DPAPI
# config.toml。本文件只需保留运行参数；密码留空即可，无需也不应在此填写真实凭据。

[runtime]
log_level = "INFO"
log_file = "logs/collector.log"
log_max_bytes = 10485760  # 10MB
log_backup_count = 5
enable_fake_bootstrap = false

[mysql]
host = "127.0.0.1"
port = 3306
user = "root"
password = ""
database = "device_watch"
charset = "utf8mb4"
pool_size = 10
max_overflow = 20
pool_timeout = 30
pool_recycle = 3600

[interface_ingest]
enabled = true
host = "127.0.0.1"
port = 8090
path = "/ingest"
api_key = ""
max_batch_size = 1000

[redis]
host = "127.0.0.1"
port = 6379
db = 0
password = ""
stream_shard_count = 4
stream_maxlen = 500000  # 约 3 分钟停机容量（305 台 × 10 帧/s × 180s ≈ 549000）
