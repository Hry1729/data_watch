# writer settings 模板 —— 安装器复制到 C:\ProgramData\DataWatch\writer\config\settings.toml
# 连接凭据（redis/mysql/tdengine 的 host/port/user/database/password）由 Agent 经
# DATAWATCH_<DB>_<FIELD> 环境变量统一注入并覆盖本文件——单一来源 = Agent 的 DPAPI
# config.toml。本文件只需保留运行参数；密码留空即可，无需也不应在此填写真实凭据。

[redis]
host = "127.0.0.1"
port = 6379
db = 0
password = ""
stream_shard_count = 4
group_name = "writer_cg"
consumer_name = "writer-1"

[tdengine]
host = "127.0.0.1"
port = 6041
user = "root"
password = ""
database = "device_data"

[mysql]
host = "127.0.0.1"
port = 3306
user = "root"
password = ""
database = "device_watch"

[writer]
flush_interval_ms = 500
batch_count = 200
max_buffer_rows = 2000
pending_min_idle_ms = 30000
pending_max_retry = 5
