BACKEND_APP_NAME=Industrial Device Monitor Backend
BACKEND_APP_VERSION=0.1.0
BACKEND_LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_API_PREFIX=/api/device-monitor
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:1420,http://127.0.0.1:1420

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=device_watch
MYSQL_CHARSET=utf8mb4

TDENGINE_HOST=127.0.0.1
TDENGINE_PORT=6041
TDENGINE_USER=root
TDENGINE_PASSWORD=changeme
TDENGINE_DATABASE=device_data
TDENGINE_USE_SSL=false
# 「数据库日志」查看页读取 TDengine 服务日志的目录。仅 compose 托管 TDengine 时设为
# /tdengine-logs（见 deploy/docker-compose.yml 的只读卷）；dev 通常留空 → 该页提示不可用。
TDENGINE_LOG_DIR=

PERSPECTIVE_ENABLED=true
PERSPECTIVE_WS_PATH=/ws/perspective
PERSPECTIVE_MAX_CLIENTS=200
PERSPECTIVE_SESSION_IDLE_TTL_SECONDS=900
PERSPECTIVE_SESSION_RESTORE_TTL_SECONDS=300
PERSPECTIVE_MAX_SESSIONS_PER_OWNER=3
PERSPECTIVE_MAX_SESSIONS_GLOBAL=100
PERSPECTIVE_MAX_POINTS_PER_QUERY=20
PERSPECTIVE_MAX_RANGE_HOURS=24
PERSPECTIVE_MAX_RECORDS_PER_QUERY=200000
PERSPECTIVE_PING_INTERVAL_SECONDS=15
PERSPECTIVE_TIMEOUT_SECONDS=45

AUTH_SECRET_KEY=replace-with-a-strong-random-secret
AUTH_ACCESS_TOKEN_EXPIRE_SECONDS=28800
AUTH_REFRESH_TOKEN_EXPIRE_SECONDS=604800
AUTH_AUTO_BOOTSTRAP=true

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Writer Redis 消费组名（须与 writer/config/settings.toml 的 redis.group_name 一致；
# Docker 镜像内无 writer/ 目录时靠此环境变量，缺省为 writer_cg）
WRITER_REDIS_GROUP_NAME=writer_cg

# Backend 调用本机 Agent 编排驱动安装/卸载（勿把 token 放进浏览器请求体）
DATAWATCH_AGENT_BASE_URL=http://127.0.0.1:7070
DATAWATCH_AGENT_SERVICE_TOKEN=
