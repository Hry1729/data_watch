# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 虚拟环境
collector/.venv/
collector/.venv-pack/
agent/.venv/
# backend/.py314t-site/ 是项目基础设施（含运行依赖），不忽略

# 构建输出
dist/
agent/build/
collector/dist/
frontend/dist/
deploy/*.zip
deploy/images/*.tar

# 前端
frontend/node_modules/

# 工具缓存
.uv-cache/
.vite/

# AI 工具本地状态
.claude/
.agent_context/
.multica/
.opencode/

# 日志
backend/logs/
collector/logs/
writer/logs/
agent/logs/
*.log

# 临时文件（Claude Code 调试产物）
.tmp_*
backend/.tmp_*

# 本地配置（含密码，不进版本库）
# agent/config.toml 含 jwt_secret + DPAPI 加密密码，有 config.toml.example 作为模板
agent/config.toml
# backend/.env、deploy/backend.env 含真实密码与 JWT secret，.env.example 仅作模板
backend/.env
deploy/backend.env
# collector/writer 本地配置：连接凭据由 Agent 经 env 注入，settings.toml 仅作 dev 本地回退；
# settings.toml.example 作为模板。生产凭据单一来源为 agent/config.toml（DPAPI 加密）。
collector/config/settings.toml
writer/config/settings.toml

# 数据导出
backend/exports/

# IDE
.idea/
.vscode/
*.swp
*.swo
