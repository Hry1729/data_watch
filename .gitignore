# Python
__pycache__/
*.py[co]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 虚拟环境
collector/.venv/
collector/.venv-pack/
writer/.venv/
writer/.venv-pack/
agent/.venv/
agent/.venv-pack/
backend/.venv-314t/
# backend/.py314t-site/ 是项目基础设施（含运行依赖），不忽略

# 构建输出
dist/
artifacts/
build/
agent/build/
collector/build/
collector/dist/
writer/build/
frontend/dist/
app/dist/
app/src-tauri/target/
deploy/*.zip
deploy/images/*.tar

# 文档归档（旧文档，仅本地留存，不进版本库）
docs/_archive/

# 前端
frontend/node_modules/
app/node_modules/

# 工具缓存
.uv-cache/
.vite/

# AI 工具本地状态
.claude/
.agent_context/
.multica/
.opencode/
.agents/
.codex/

# 日志
backend/logs/
collector/logs/
writer/logs/
agent/logs/
collector/sidecars/*/logs/
*.log

# 临时文件（Claude Code 调试产物）
.tmp_*
backend/.tmp_*
backend/.pip-temp/

# 本地配置（含密码，不进版本库）
# agent/config.toml 含 jwt_secret + DPAPI 加密密码，有 config.toml.example 作为模板
agent/config.toml
# backend/.env、deploy/backend.env 含真实密码与 JWT secret，.env.example 仅作模板
backend/.env
deploy/backend.env
# collector/writer 本地配置：连接凭据由 Agent 经 env 注入，settings.toml 仅作 dev 本地回退；
# settings.toml.example 作为模板。生产凭据单一来源为 agent/config.toml（DPAPI 加密）。
collector/config/settings.toml
writer/config/settings.toml

# 运行期状态（Agent/proxy 运行时生成，含环境相关 IP/端口）
collector/port_mapping.json
collector/sidecars/opcda_proxy_service/runtime/

# sidecar 编译产物（由各自 build.ps1 用 csc.exe 重建，bin/*.json 配置仍跟踪）
collector/sidecars/*/bin/*.exe

# 数据导出
backend/exports/
outputs/

# Edge 运行时数据（源码运行时 edge_database_path() 的默认位置）：
# 内含 edge.db 与 storage-ipc-tokens.json（IPC 凭据），绝不可入库。
edge/data/

# 根目录历史快照
data_watch_full_*.zip
executables_*.zip

# IDE
.idea/
.vscode/
*.swp
*.swo

# 本地授权与发布签名密钥
*.key

# CLI release signing private keys
packaging/keys/
backend/cli-releases/

# 前端未完成功能（本地保留，不上传）
frontend/src/views/landing/
frontend/src/views/monitor-screen/
frontend/src/views/monitor-light/

# 本地测试 / 诊断辅助（仅本地保留，不上传）
docs/测试/*.ps1
docs/测试/*.cmd
docs/测试/scenario_io.py
docs/测试/simulate_*.py
docs/测试/diagnose_*.py
docs/测试/test_scenarios.py
docs/测试/入库诊断说明.md
frontend/tests/history-zoom.test.ts
frontend/tests/realtime-samples.test.ts
